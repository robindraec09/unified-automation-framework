{
  "name": "unified-automation-framework",
  "version": "0.1.0",
  "private": true,
  "description": "Unified test automation framework: web, mobile, API and ETL on Playwright Test, with MCP and agent enablement",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:web": "playwright test --project=web-chromium",
    "test:mobile:android": "playwright test --project=android",
    "test:mobile:ios": "playwright test --project=ios",
    "test:etl": "playwright test --project=etl",
    "test:bank": "playwright test --project=bank-api --project=bank-web",
    "test:bank:api": "playwright test --project=bank-api",
    "test:bank:web": "playwright test --project=bank-web",
    "test:smoke": "playwright test --grep @smoke",
    "report": "playwright show-report",
    "report:stakeholder": "playwright show-report stakeholder-report --port 9324",
    "etl:up": "docker compose up -d --wait source-db warehouse-db",
    "etl:down": "docker compose rm -sf source-db warehouse-db",
    "bank:start": "tsx apps/bank/src/server.ts",
    "bank:db:init": "tsx apps/bank/scripts/db-init.ts",
    "bank:up": "docker compose up -d --build --wait bank-app",
    "bank:down": "docker compose rm -sf bank-app bank-init bank-db",
    "bank:reset": "docker compose run --rm bank-init apps/bank/node_modules/.bin/tsx apps/bank/scripts/db-init.ts",
    "bank:logs": "docker compose logs -f bank-app",
    "stack:up": "docker compose up -d --build --wait",
    "stack:test": "docker compose run --rm --build tests",
    "stack:down": "docker compose down -v --remove-orphans",
    "mcp:framework": "tsx packages/mcp-server/src/index.ts",
    "agents:init": "playwright init-agents --loop=claude",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^9.0.0",
    "@faker-js/faker": "^9.0.0",
    "@modelcontextprotocol/sdk": "^1.20.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "allure-playwright": "^3.0.0",
    "dotenv": "^16.4.0",
    "eslint": "^9.0.0",
    "eslint-plugin-playwright": "^2.0.0",
    "globals": "^17.14.0",
    "pg": "^8.13.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "webdriverio": "^9.0.0",
    "yaml": "^2.6.0",
    "zod": "^3.23.0"
  }
}
