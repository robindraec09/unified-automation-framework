# Which config/env/<name>.json to load
TEST_ENV=dev

# Web credentials (synthetic accounts only)
WEB_USER=standard_user
WEB_PASSWORD=secret_sauce

# Mobile / Appium
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723
DEVICE=android-emulator
# CLOUD=browserstack
# CLOUD_USER=
# CLOUD_KEY=

# ETL / data (matches docker/etl/docker-compose.yml)
ETL_SOURCE_URL=postgres://qa:qa@localhost:5433/source
ETL_TARGET_URL=postgres://qa:qa@localhost:5434/warehouse
ETL_PIPELINE=local
# ETL_PIPELINE=airflow
# AIRFLOW_URL=
# AIRFLOW_TOKEN=

# Harbourline Bank: local system under test (apps/bank). Defaults shown; see apps/bank/README.md
# Default: the Docker database from `pnpm bank:up` (port 5435).
# For your local PostgreSQL 17 instead: postgres://bank_app:bank_app@localhost:5432/bank + BANK_DB_ADMIN_URL, then pnpm bank:db:init
BANK_DB_URL=postgres://bank_app:bank_app@localhost:5435/bank
# Local PostgreSQL only: a superuser connection, used once by bank:db:init to create the role and database
# BANK_DB_ADMIN_URL=postgres://postgres:<your-postgres-password>@localhost:5432/postgres
# BANK_BASE_URL=http://localhost:4000
# BANK_TEST_SUPPORT=1   # enables /test-support (Playwright sets it automatically when it starts the app)
