# Which config/env/<name>.json to load
TEST_ENV=dev

# Web credentials (synthetic accounts only)
WEB_USER=standard_user
WEB_PASSWORD=secret_sauce

# Mobile / Appium
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723
DEVICE=android-emulator
# CLOUD=browserstack
# CLOUD_USER=
# CLOUD_KEY=

# ETL / data (matches docker/etl/docker-compose.yml)
ETL_SOURCE_URL=postgres://qa:qa@localhost:5433/source
ETL_TARGET_URL=postgres://qa:qa@localhost:5434/warehouse
ETL_PIPELINE=local
