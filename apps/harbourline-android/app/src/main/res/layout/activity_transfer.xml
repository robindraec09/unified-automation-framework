<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/transfer_title"
            style="@style/Heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/transfer" />

        <LinearLayout
            android:id="@+id/transfer_form"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/from_spinner"
                android:text="@string/from_account" />

            <Spinner
                android:id="@+id/from_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />

            <TextView
                style="@style/Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/to_spinner"
                android:text="@string/to_account" />

            <Spinner
                android:id="@+id/to_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />

            <TextView
                style="@style/Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/amount"
                android:text="@string/amount" />

            <EditText
                android:id="@+id/amount"
                style="@style/Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="0.00"
                android:importantForAutofill="no"
                android:inputType="numberDecimal" />

            <TextView
                style="@style/Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/description"
                android:text="@string/description" />

            <EditText
                android:id="@+id/description"
                style="@style/Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLength="140" />

            <TextView
                android:id="@+id/transfer_error"
                style="@style/ErrorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <Button
                android:id="@+id/transfer_submit"
                style="@style/PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/transfer_now" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/transfer_receipt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:background="#E7F4EC"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/receipt_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Transfer successful"
                android:textColor="@color/ok"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/receipt_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/ink" />

            <TextView
                android:id="@+id/receipt_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/muted"
                android:textIsSelectable="true"
                android:textSize="13sp" />

            <Button
                android:id="@+id/back_to_accounts"
                style="@style/PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/back_to_accounts" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
